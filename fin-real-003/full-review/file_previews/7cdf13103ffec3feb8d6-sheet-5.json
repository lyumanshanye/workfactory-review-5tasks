1807033823653,0,0,99.99999999999997],["恒定口径(49家)","Equity/Assets",9.962535014318426,9.855656630610612,-0.106878383707814,-0.1984133277553348,0.0915349440475192,0,0,100.0000000000015],["恒定口径(49家)","Loans/Assets",69.54072121065319,77.17461876261198,7.633897551958796,6.945522599352402,0.688374952606404,0,0,100.0000000000001],[null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null],["解读要点（主窗口A）：",null,null,null,null,null,null,null,null,null],["· ROA Δ-4.7bp：持续机构自身表现拖累-17.2bp，规模权重变化+8.9bp（高ROA机构扩张快于低ROA机构），进入+2.9bp（含信托公司离群值），退出+0.7bp —— 盈利下滑主要是持续机构自身现象。",null,null,null,null,null,null,null,null,null],["· 非应计/资产 Δ+13.3bp：表现+11.3bp（占85%），权重+3.3bp，退出-1.7bp —— 信用恶化85%来自持续机构自身。NCL(+15.0bp, 表现占82%)与净核销(+3.6bp, 表现占75%)同向印证。",null,null,null,null,null,null,null,null,null],["· 权益/资产 Δ+6.8bp：持续机构自身实际为-18.9bp（留存收益增长慢于资产扩张+并购），+47.6bp来自权重与进入/退出（低杠杆并购方吸收高杠杆被并方、高资本de novo进入）—— 资本比率持平是构成假象，持续机构资本缓冲在变薄。",null,null,null,null,null,null,null,null,null],["· 贷款/存款 Δ+13.3pp：表现+12.1pp（持续机构自身放贷快于吸存：贷款CAGR约10.3% vs 存款约5.2%），构成贡献小 —— 资金趋紧为真实现象。",null,null,null,null,null,null,null,null,null],["· NIM窗口A口径Δ+1.3bp为\"低谷后回升+并购方并表高收益资产\"混合结果：持续机构自身NIM -8.9bp，退出机构（Northway/Gorham为低NIM储蓄机构）移除贡献-13.9bp反向（即退出拉高了组合），2024Q1低谷2.754%→2025Q2回升3.168%。",null,null,null,null,null,null,null,null,null]],"total_rows":34,"total_columns":10,"truncated":false,"row_limit":2000,"column_limit":50}
